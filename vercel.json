{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @cuentas-claras/app build",
  "outputDirectory": "apps/app/dist",
  "cleanUrls": true,
  "rewrites": [{ "source": "/:path*", "destination": "/" }]
}
